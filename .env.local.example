###############################################################
# 🔥 SOVEREIGN LAUNCHPAD - ENVIRONMENT CONFIGURATION 🔥
# Copy this file to .env.local and fill in your values
###############################################################

# =============================================================
# SOLANA CONFIGURATION (TESTNET DEFAULT)
# =============================================================

# RPC URL for Solana connection
# Devnet (for testing): https://api.devnet.solana.com
# Mainnet (for production): https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
RPC_URL=https://api.devnet.solana.com

# Network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# =============================================================
# CLOUDFLARE R2 STORAGE (for token logos & metadata)
# =============================================================
# Get these from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens

R2_ACCESS_KEY_ID=your_r2_access_key_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_BUCKET=token-metadata

# =============================================================
# METEORA CONFIGURATION
# =============================================================
# Pool Config Key - determines bonding curve parameters
# For devnet testing, you can use a test config or create your own

# TESTNET POOL CONFIG (for testing only)
POOL_CONFIG_KEY=CpTDzD6KYGHA28Wn9rZs7MM8UPZHvYgjD2Y5ZdPjuBWu

# =============================================================
# SITE CONFIGURATION
# =============================================================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sovereign Launchpad

# =============================================================
# OPTIONAL: MAINNET PRODUCTION (when ready)
# =============================================================
# Uncomment and fill these when deploying to mainnet:

# NEXT_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# POOL_CONFIG_KEY=your_mainnet_pool_config_key

# =============================================================
# KING HERMES INTEGRATION (optional)
# =============================================================

# KING_HERMES_API_URL=https://api.hermes.ai
# KING_HERMES_API_KEY=your_api_key_here

# =============================================================
# HOW TO GET THESE KEYS:
# =============================================================
# See: GETTING-STARTED.md for step-by-step instructions
# Or visit: https://github.com/your-repo/sovereign-launchpad
#
# Quick Links:
# - Cloudflare R2: https://dash.cloudflare.com/sign-up
# - Helius RPC: https://helius.xyz
# - Meteora Docs: https://docs.meteora.ag
#
###############################################################
